# Google Gemini API 키 (채팅용, 무료 티어) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# (선택) 채팅·번역 API 개인 접근 코드 — 설정하면 앱에서 처음 한 번 입력해야 사용 가능 (비우면 검사 안 함)
APP_PASSCODE=
# (선택) 채팅 모델 변경 — 기본 gemini-flash-lite-latest, 혼잡 시 대체 모델 gemini-2.5-flash
CHAT_MODEL=
CHAT_FALLBACK_MODEL=
# (선택) Gemini 대신 다른 OpenAI 호환 채팅 API 사용 시
CHAT_API_URL=
CHAT_API_KEY=
# (선택) DeepL API Free 키 (끝이 :fx) — Gemini 번역 실패 시 사용
DEEPL_API_KEY=
# (선택) DeepL 키가 없을 때 쓰는 MyMemory 무료 번역의 일일 한도를 늘리려면 이메일 입력
MYMEMORY_EMAIL=
# (선택) Semantic Scholar API 키 — 인용수 조회 429 방지
S2_API_KEY=
# (선택) 한 번 실행에 새로 추가할 최대 편수 — 기본 10
MAX_PAPERS=
# (선택) 게시일이 최근 N일 이내인 논문만 새로 추가 — 기본 14
LOOKBACK_DAYS=
# (선택) 누적 보관 기간(수집일 기준 일수)·최대 편수 — 기본 90일, 300편
KEEP_DAYS=
MAX_STORED=
